# Canar Accounting — production environment (copy to /opt/canar-accounting/.env)
# The VITE_* values are baked in at build time; the rest are read at runtime.

# --- Supabase project (same values currently in the repo's .env) ---
SUPABASE_PROJECT_ID=wwiclujwhdejdijynkht
SUPABASE_URL=https://wwiclujwhdejdijynkht.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_5l4d8bF5opZPEQ7DPzxpWA_cm3d3HE9
VITE_SUPABASE_PROJECT_ID=wwiclujwhdejdijynkht
VITE_SUPABASE_URL=https://wwiclujwhdejdijynkht.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5l4d8bF5opZPEQ7DPzxpWA_cm3d3HE9

# --- SECRETS: fill these in on the server only, never commit them ---
# Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for the pg_cron webhooks (any long random string; the same
# value goes into Vault as 'cron_hook_secret' — apply-migrations.sh does this)
CRON_HOOK_SECRET=
# AI gateway key (AP invoice extraction / copilot). Optional but AI features
# fail without it. This app is Lovable-provisioned:
LOVABLE_API_KEY=
# Optional fallback for direct Anthropic Claude API calls if used:
# ANTHROPIC_API_KEY=

# --- Webhooks (email/WhatsApp intake) — set if you use those channels ---
# AP_INTAKE_HMAC_SECRET=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
